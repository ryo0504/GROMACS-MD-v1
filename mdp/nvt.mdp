; Example only: 100 ps at 2 fs, velocities generated once with a recorded seed.
integrator = md
dt = 0.002
nsteps = 50000
continuation = no
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
DispCorr = EnerPres
pbc = xyz
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 298.15
pcoupl = no
gen-vel = yes
gen-temp = 298.15
gen-seed = 20261004
nstenergy = 500
nstlog = 500
nstxout-compressed = 500
