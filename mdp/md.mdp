; Example only: 1 ns, Parrinello-Rahman; begin only after reviewed equilibration.
integrator = md
dt = 0.002
nsteps = 500000
continuation = yes
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
DispCorr = EnerPres
pbc = xyz
tcoupl = v-rescale
tc-grps = System
tau-t = 1.0
ref-t = 298.15
pcoupl = Parrinello-Rahman
pcoupltype = isotropic
tau-p = 5.0
ref-p = 1.0
compressibility = 4.5e-5
gen-vel = no
nstenergy = 500
nstlog = 500
nstxout-compressed = 500
