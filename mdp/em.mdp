; Educational periodic condensed-phase template; review against your physical system.
integrator = steep
nsteps = 5000
emtol = 1000
emstep = 0.01
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
DispCorr = EnerPres
pbc = xyz
constraints = none
nstenergy = 100
nstlog = 100
