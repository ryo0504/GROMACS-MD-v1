; Prepared input. QM/RESP/topology validation still required.
integrator                 = md
dt                         = 0.001
tinit                      = 0
pbc                        = xyz
cutoff-scheme              = Verlet
nstlist                    = 20
verlet-buffer-tolerance    = 0.005
coulombtype                = PME
rcoulomb                   = 1.0
ewald-rtol                 = 1e-5
pme-order                  = 4
fourierspacing             = 0.12
vdwtype                    = Cut-off
rvdw                       = 1.0
vdw-modifier               = Potential-shift
DispCorr                   = EnerPres
constraints                = none
constraint-algorithm       = lincs
lincs-order                = 4
lincs-iter                 = 1
tcoupl                     = no
pcoupl                     = no
comm-mode                  = Linear
comm-grps                  = System
nstcomm                    = 100
nstcalcenergy              = 1
nstenergy                  = 1
nstlog                     = 1
nstxout                    = 1
nstvout                    = 0
nstfout                    = 1
nstxout-compressed         = 0
compressed-x-precision     = 10000
gen-vel                    = no
continuation               = no
ld-seed                    = 201
annealing                  = no
nsteps                     = 0
init-step                  = 0
