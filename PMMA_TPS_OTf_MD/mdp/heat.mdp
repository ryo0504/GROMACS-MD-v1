; Prepared input. QM/RESP/topology validation still required.
integrator                 = md
dt                         = 0.001
tinit                      = 0
pbc                        = xyz
cutoff-scheme              = Verlet
nstlist                    = 20
verlet-buffer-tolerance    = 0.005
coulombtype                = PME
rcoulomb                   = 1.0
ewald-rtol                 = 1e-5
pme-order                  = 4
fourierspacing             = 0.12
vdwtype                    = Cut-off
rvdw                       = 1.0
vdw-modifier               = Potential-shift
DispCorr                   = EnerPres
constraints                = h-bonds
constraint-algorithm       = lincs
lincs-order                = 4
lincs-iter                 = 1
tcoupl                     = v-rescale
tc-grps                    = System
tau-t                      = 1.0
pcoupl                     = no
comm-mode                  = Linear
comm-grps                  = System
nstcomm                    = 100
nstcalcenergy              = 100
nstenergy                  = 1000
nstlog                     = 1000
nstxout                    = 0
nstvout                    = 0
nstfout                    = 0
nstxout-compressed         = 1000
compressed-x-precision     = 10000
gen-vel                    = yes
continuation               = no
ld-seed                    = 201
annealing                  = single
init-step                  = 0
nsteps                     = 200000
ref-t                      = 300
gen-temp                   = 300
gen-seed                   = 1
annealing-npoints          = 2
annealing-time             = 0 200
annealing-temp             = 300 1400
